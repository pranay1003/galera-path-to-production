# Rendered by Terraform (do not edit by hand — see terraform/inventory.tf).
# Galera nodes are reached on their private IPs via the HAProxy jump host.

[haproxy]
haproxy-1 ansible_host=${haproxy_ip}

[galera]
%{ for az, ip in galera_private_ips ~}
galera-${az} ansible_host=${ip} ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 ${ssh_user}@${haproxy_ip}"'
%{ endfor ~}

[all:vars]
ansible_user=${ssh_user}
